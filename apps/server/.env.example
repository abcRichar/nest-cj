# ---------------- 应用 ----------------
NODE_ENV=development
APP_NAME=elp-server
PORT=8080
API_PREFIX=/api

# ---------------- 数据库（必填） ----------------
# 格式：mysql://用户名:密码@主机:端口/库名
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/english_platform"

# ---------------- JWT ----------------
JWT_SECRET=elp_super_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---------------- 接口签名（需与前端 VITE_SIGN_KEY 一致） ----------------
SIGN_KEY=elp_client_sign_key_dev

# ---------------- CORS ----------------
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------------- AI 服务（独立进程） ----------------
AI_SERVICE_URL=http://127.0.0.1:8090
AI_SERVICE_TOKEN=elp_internal_token

# ---------------- 支付宝（沙箱即可） ----------------
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:8080/api/payment/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5173/payment/result

# ---------------- MinIO 对象存储 ----------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=english-platform
# 对外可访问地址（用于拼接文件 URL）
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# ---------------- 邮件（学习日报） ----------------
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_mail@qq.com
MAIL_PASS=your_smtp_authorization_code
MAIL_FROM="英语学习平台 <your_mail@qq.com>"

# ---------------- 定时任务 ----------------
DAILY_REPORT_CRON=0 0 21 * * *
ENABLE_SCHEDULE=true

# ---------------- 前端地址（支付宝同步跳转回跳用） ----------------
FRONTEND_URL=http://localhost:5173
