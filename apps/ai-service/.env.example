# ---------------- 应用 ----------------
NODE_ENV=development
PORT=8090
API_PREFIX=/api

# 与主业务服务约定的内部令牌，防止 AI 服务被外部直接调用
INTERNAL_TOKEN=elp_internal_token

# ---------------- DeepSeek（OpenAI 兼容协议） ----------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2048

# ---------------- 会话状态持久化（LangGraph Checkpoint） ----------------
# 与主业务服务共用同一个库（表：checkpoints / checkpoint_blobs / checkpoint_writes）
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/english_platform"

# ---------------- 联网搜索 ----------------
# 不填则使用 DuckDuckGo 免密钥通道（能力较弱，仅兜底）
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# ---------------- Agent ----------------
AGENT_MAX_ITERATIONS=8
